# =============================================================================
#  UFT Automation Framework - environment configuration
#
#  1. Copy this file to .env  (cp .env.example .env)
#  2. Fill in the values for your project
#  3. NEVER commit .env - it is listed in .gitignore
#
#  Windows environment variables with the same name override these values
#  (useful for Jenkins / Azure DevOps credentials).
#  Optional overlay: set TEST_ENV=qa to also load .env.qa on top of this file.
# =============================================================================

# ---- Application ------------------------------------------------------------
APP_NAME=MyApplication
TEST_ENV=
BASE_URL=https://snpo-stage.sandbox.operations.dynamics.com

# ---- Credentials ------------------------------------------------------------
APP_USERNAME=snaptester05@snapone.com
APP_PASSWORD=M-RI{B#2@YZ%{z!+=28hCFwf#

# ---- Browser ----------------------------------------------------------------
# chrome | edge | firefox
BROWSER=chrome
BROWSER_ARGS=--start-maximized
OPEN_BROWSER_PER_TEST=true
CLOSE_BROWSERS_BEFORE_TEST=true
CLOSE_ALL_BROWSERS=false

# ---- Timeouts (seconds) -----------------------------------------------------
DEFAULT_TIMEOUT=10
PAGE_LOAD_TIMEOUT=60

# ---- Framework paths (relative to the framework root) -----------------------
EXECUTION_FILE=TestData\Execution.csv
# Leave empty to load every *.tsr in ObjectRepository\ ; separate several with ;
OBJECT_REPOSITORY=

# ---- Reporting --------------------------------------------------------------
SCREENSHOT_ON_FAIL=true
SCREENSHOT_ON_PASS=false

# ---- Command-line runner (Scripts\RunTest.vbs) ------------------------------
# Leave empty to use <root>\Results
RESULTS_DIR=
UFT_VISIBLE=true
